{
  "name": "resonance-qloo",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "qloo:proof": "node scripts/qloo-mcp-proof.mjs",
    "qloo:proof:redaction:selftest": "node scripts/test-proof-redaction.mjs",
    "qloo:proof:env:selftest": "node scripts/test-proof-environment.mjs",
    "submission:preflight": "npm run security:secrets:check && node scripts/submission-preflight.mjs",
    "submission:preflight:offline": "npm run security:secrets:check && node scripts/submission-preflight.mjs --offline",
    "deployment:check": "node scripts/check-deployment.mjs",
    "qloo:live:check": "node scripts/check-live-qloo.mjs",
    "qloo:live:selftest": "node scripts/test-live-qloo-check.mjs",
    "qloo:cutover:verify": "npm run deployment:check && npm run qloo:live:check -- --refresh",
    "deployment:check:selftest": "node scripts/test-deployment-checker.mjs",
    "evidence:capture": "node scripts/capture-live-evidence.mjs",
    "evidence:capture:selftest": "node scripts/test-evidence-capture.mjs",
    "verify:offline": "npm run security:secrets:selftest && npm run security:secrets:check && npm run floot:production:parity && npm run impact:study:selftest && npm run typecheck && npm test && npm run build && npm run smoke:preview && npm run ui:state:selftest && npm run deployment:check:selftest && npm run qloo:live:selftest && npm run qloo:proof:redaction:selftest && npm run qloo:proof:env:selftest && npm run evidence:capture:selftest && npm run submission:preflight:offline",
    "ui:state:selftest": "node scripts/test-ui-state-safety.mjs",
    "security:secrets:check": "node scripts/check-secret-leaks.mjs",
    "security:secrets:selftest": "node scripts/test-secret-leaks.mjs",
    "floot:production:parity": "node scripts/check-floot-production-parity.mjs",
    "study:analyze": "tsx scripts/analyze-study-responses.ts",
    "impact:study": "node scripts/summarize-impact-study.mjs",
    "impact:study:selftest": "node scripts/test-impact-study.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "dotenv": "16.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
